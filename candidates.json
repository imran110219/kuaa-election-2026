  {
    "position": "Assistant Sports and Cultural Secretary",
    "name": "Md Saydur Rahman Lushan",
    "discipline": "Architecture",
    "studentId": "120135",
    "batch": 2012,
    "photo": "public/candidates/120135.jpeg",
    "manifesto": {
      "title": "একটি অন্তর্ভুক্তিমূলক ও সার্বজনীন KUAA গঠন ও কার্যক্রম বিকেন্দ্রীকরণের ইশতেহার",
      "greeting": "আসসালামু আলাইকুম।",
      "candidateIntro": "আমি লুশান (মোঃ সাইদুর রহমান, স্থাপত্য ১২ ব্যাচ)। আসন্ন “KUAA” নির্বাচনে আমি ক্রীড়া ও সাংস্কৃতিক সহ-সম্পাদক পদে অংশগ্রহণ করছি।",
      "introduction": [
        "আমার প্রাথমিক উদ্দেশ্য অবশ্যই জয়লাভ করা নয়; বরং ইউনিভার্সিটির অ্যাসোসিয়েশন নিয়ে সামগ্রিক স্বার্থে কিছু স্বপ্ন বাস্তবায়নের প্রক্রিয়ায় অবদান রাখার চেষ্টা করা। অংশগ্রহণের প্রক্রিয়ার মাধ্যমেও অনেকাংশে সেই স্বপ্ন বাস্তবায়নের চেষ্টা করা সম্ভব। আর তারই ধারাবাহিকতায় আমার ভাবনাগুলো উল্লেখ করেছি, যেখানে ভোটের চেয়ে KUAA নিয়ে সবার সম্মিলিত চিন্তা বেশি প্রয়োজন।",
        "এই ভাবনায় KUAA’র ক্রীড়া ও সাংস্কৃতিক কার্যক্রমকে অন্তর্ভুক্তিমূলক ও বিকেন্দ্রীকরণের বিষয়টি বেশি প্রাধান্য পেয়েছে, যা KUAA-এর কার্যক্রম বাস্তবায়নে আরও সক্রিয় ভূমিকা রাখবে।"
      ],
      "proposals": [
        "ক্রীড়া ও সংস্কৃতিকে অন্তর্ভুক্তিমূলক করতে সশরীরে উপস্থিতিনির্ভর ইভেন্টের পাশাপাশি অনলাইন ইভেন্টের ব্যবস্থা করা—যেমন অনলাইন গেমিং টুর্নামেন্ট, সাংস্কৃতিক স্মৃতিচারণ ও কোলাবোরেশন।",
        "সকল অ্যালুমনির অবস্থান ও অংশগ্রহণের নিশ্চয়তা বিবেচনা করে শুধু ঢাকা-কেন্দ্রিক সিদ্ধান্ত ও কার্যক্রম বিকেন্দ্রীকরণ করা এবং শহরভিত্তিক নিয়মিত ক্রীড়া ও সাংস্কৃতিক ইভেন্ট আয়োজন করা।",
        "বিভিন্ন জাতীয় ও আন্তর্জাতিক অরাজনৈতিক দিবসে শহরভিত্তিক ম্যারাথন রেস ও ফ্যামিলি ডে উদযাপনের ব্যবস্থা করা।",
        "নিজেদের প্রাণের প্রিয় বিশ্ববিদ্যালয়ে প্রতি ছয় মাস অন্তর একটি ক্রীড়া ও সাংস্কৃতিক অনুষ্ঠানের আয়োজন করা।",
        "বিশ্ববিদ্যালয়ের ক্রীড়া ও সাংস্কৃতিক কার্যক্রমে বর্তমান শিক্ষার্থীদের স্পনসরশিপসহ (অভ্যন্তরীণ ও বহিরাগত) সার্বিক সহযোগিতার ব্যবস্থা করা।",
        "KUAA-কে অন্তর্ভুক্তিমূলক ও কার্যকর করতে প্রতিটি ক্ষেত্র অনুযায়ী শহরভিত্তিক সাবকমিটি গঠন করা।"
      ]
    }
