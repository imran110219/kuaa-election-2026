      "labelEn": "Alumni connection & inclusion",
      "definition": "Membership, cross-batch and discipline connections, regional chapters, networking, and community-building."
    },
    {
      "id": "career",
      "labelBn": "ক্যারিয়ার, কর্মসংস্থান ও উদ্যোক্তা",
      "labelEn": "Career, jobs & entrepreneurship",
      "definition": "Jobs, internships, career guidance, mentoring for work, professional development, and entrepreneurship."
    },
    {
      "id": "education",
      "labelBn": "শিক্ষা, গবেষণা ও দক্ষতা",
      "labelEn": "Education, research & skills",
      "definition": "Higher education, research, practical training, seminars, and skill development."
    },
    {
      "id": "student",
      "labelBn": "শিক্ষার্থী ও নবীন গ্র্যাজুয়েট সহায়তা",
      "labelEn": "Student & new graduate support",
      "definition": "Scholarships, student mentoring, project support, graduate transition, and early-career assistance."
    },
    {
      "id": "welfare",
      "labelBn": "কল্যাণ, স্বাস্থ্য ও মানবিক সহায়তা",
      "labelEn": "Welfare, health & humanitarian support",
      "definition": "Emergency, medical, legal, social, blood-donor, and hardship support."
    },
    {
      "id": "digital",
      "labelBn": "ডিজিটাল সেবা, তথ্য ও যোগাযোগ",
      "labelEn": "Digital services, data & communication",
      "definition": "Websites, apps, directories, databases, digital access, communication channels, and portals."
    },
    {
      "id": "governance",
      "labelBn": "স্বচ্ছতা, জবাবদিহি ও অংশগ্রহণ",
      "labelEn": "Transparency, accountability & participation",
      "definition": "Financial reporting, member voice, inclusive decision-making, organizational accountability, and participation."
    },
    {
      "id": "facilities",
      "labelBn": "অফিস, আবাসন ও প্রবেশাধিকার",
      "labelEn": "Office, housing & access",
      "definition": "Offices, guest houses, accommodation, campus access, and physical member facilities."
    },
    {
      "id": "events",
      "labelBn": "ক্রীড়া, সংস্কৃতি ও পুনর্মিলনী",
